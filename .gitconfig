[alias]
  aa = add --all
  ap = add --patch
  ca = commit --amend -v
  ci = commit -v
  co = checkout
  create-branch = !sh -c 'git push origin HEAD:refs/heads/$1 && git fetch origin && git branch --track $1 origin/$1 && cd . && git checkout $1' -
  delete-branch = !sh -c 'git push origin :refs/heads/$1 && git remote prune origin && git branch -D $1' -
  lol = log --graph --decorate --pretty=oneline --abbrev-commit --all
  lom = !git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(cyan)<%an>%Creset' --abbrev-commit --date=relative origin/$(git main)..HEAD
  main = !git symbolic-ref refs/remotes/origin/HEAD | cut -d'/' -f4
  merge-branch = !git checkout master && git merge @{-1}
  st = status
  stat = status -sb
  fpush = push
[blame]
  ignoreRevsFile = .git-blame-ignore-revs
[color]
  diff = true
  ui = true
[commit]
  verbose = true
[core]
  autocrlf = input
  editor = nvim
  excludesfile = ~/.gitignore_global
  pager = diff-so-fancy | less --tabs=4 -RFX
[grep]
  patternType = perl
[feature]
  experimental = true
[diff]
  colorMoved = true
  algorithm = histogram
  mnemonicPrefix = true
  renames = true
[diff-so-fancy]
  markEmptyLines = false
[filter "lfs"]
  clean = git-lfs clean -- %f
  process = git-lfs filter-process
  required = true
  smudge = git-lfs smudge -- %f
[include]
  path = ~/.gitconfig.local # see .gitconfig.local
[init]
  defaultBranch = main
  templateDir = ~/.git-template
[interactive]
  diffFilter = diff-so-fancy --patch
[pull]
  rebase = false
[push]
  autoSetupRemote = true
  default = current
[rebase]
  autoSquash = true
  updateRefs = true
  autoStash = true
[rerere]
  enabled = true
  autoupdate = true
[branch]
  sort = -committerdate
[merge]
  conflictStyle = zdiff3
  autoStash = true
[alias]
  branch = branch --sort=-committerdate
  merge-staging = !git fetch origin +staging:staging && git checkout staging && git merge - --no-edit && git push && git checkout -
	pushf = "!f() { b=$(git branch --show-current); case \"$b\" in do/*|cloud-agent/*) git push --force-with-lease --force-if-includes origin \"refs/heads/$b:refs/heads/$b\" ;; *) echo \"pushf: refuse to push $b\" >&2; return 1 ;; esac; }; f"
	fold = "!f() { [ -n \"$1\" ] || { echo 'usage: git fold <commit>' >&2; return 1; }; t=$(git rev-parse --verify --quiet \"$1^{commit}\") || { echo \"fold: unknown commit $1\" >&2; return 1; }; m=$(git main) && git rev-parse --verify --quiet \"origin/$m\" >/dev/null || { echo 'fold: cannot resolve origin main branch' >&2; return 1; }; git merge-base --is-ancestor \"$t\" HEAD || { echo \"fold: $1 is not on this branch\" >&2; return 1; }; if git merge-base --is-ancestor \"$t\" \"origin/$m\"; then echo \"fold: $1 is already on origin/$m\" >&2; return 1; fi; pr=$(gh pr view --json headRefOid -q .headRefOid) || return 1; [ \"$(git rev-parse HEAD)\" = \"$pr\" ] || { echo \"fold: HEAD $(git rev-parse --short HEAD) differs from the PR head $pr\" >&2; return 1; }; git commit --fixup=\"$t\" || return 1; git rebase --autosquash \"$t^\" || return 1; if git log --format=%s \"$t^..HEAD\" | grep -q '^fixup! '; then echo 'fold: a fixup commit remains' >&2; return 1; fi; git lom; echo; }; f"
[tag]
  sort = version:refname
[fetch]
  prune = true
  pruneTags = true
  all = true
