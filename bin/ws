#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo 'usage: ws "<label>" [-b|--branch <branch>] [-- <claude args>]'
}

label=""
branch=""
claude_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -b|--branch)
      [[ $# -ge 2 ]] || { echo "ws: $1 needs a value" >&2; exit 1; }
      branch="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      claude_args=("$@")
      break
      ;;
    -*)
      echo "ws: unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      [[ -z "$label" ]] || { echo "ws: unexpected argument: $1" >&2; exit 1; }
      label="$1"
      shift
      ;;
  esac
done

if [[ -z "$label" ]]; then
  usage >&2
  exit 1
fi

required=(herdr jq)
[[ -n "$branch" ]] && required+=(wt)
for cmd in "${required[@]}"; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "ws: $cmd not found in PATH" >&2
    exit 1
  fi
done

cwd="$PWD"

if [[ -n "$branch" ]]; then
  switched="$(wt switch --create "$branch" --no-cd --format json -y -C "$cwd")"
  cwd="$(jq -r '.path // empty' <<<"$switched")"
  if [[ -z "$cwd" || ! -d "$cwd" ]]; then
    echo "ws: wt switch did not report a worktree path" >&2
    exit 1
  fi
fi

created="$(herdr workspace create --cwd "$cwd" --label "$label" --no-focus)"
workspace_id="$(jq -r '.result.workspace.workspace_id' <<<"$created")"
nvim_tab="$(jq -r '.result.tab.tab_id' <<<"$created")"
nvim_pane="$(jq -r '.result.root_pane.pane_id' <<<"$created")"

herdr tab rename "$nvim_tab" nvim >/dev/null
herdr pane run "$nvim_pane" nvim

shell_tab="$(herdr tab create --workspace "$workspace_id" --cwd "$cwd" --label shell --no-focus)"
shell_pane="$(jq -r '.result.root_pane.pane_id' <<<"$shell_tab")"
if [[ -n "$branch" ]]; then
  herdr pane run "$shell_pane" "box update-app"
fi

claude_tab="$(herdr tab create --workspace "$workspace_id" --cwd "$cwd" --label claude --no-focus)"
claude_tab_id="$(jq -r '.result.tab.tab_id' <<<"$claude_tab")"
claude_pane="$(jq -r '.result.root_pane.pane_id' <<<"$claude_tab")"
claude_name="${branch:-$label}"
claude_cmd="claude --name $(printf '%q' "$claude_name")"
for arg in "${claude_args[@]}"; do
  claude_cmd+=" $(printf '%q' "$arg")"
done
herdr pane run "$claude_pane" "$claude_cmd"

herdr tab focus "$claude_tab_id" >/dev/null
herdr workspace focus "$workspace_id" >/dev/null
