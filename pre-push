#!/bin/bash

# Check if pushing to main is allowed in this repository
allow_push_main=$(git config --get hooks.allowpushmain)

if [ "$allow_push_main" != "true" ]; then
  while read local_ref local_sha remote_ref remote_sha
  do
    # Only examine branch refs
    if [[ "$local_ref" =~ ^refs/heads/ ]]; then
      branch_name=${local_ref#refs/heads/}
      if [ "$branch_name" == "main" ]; then
        echo "error: refusing to push local 'main' directly (global pre-push hook, ~/dotfiles/pre-push)" >&2
        echo "  Push a feature branch and open a PR instead, or to allow direct pushes to main in just this repo:" >&2
        echo "    git config hooks.allowpushmain true" >&2
        exit 1
      fi
    fi
  done
fi

exit 0
